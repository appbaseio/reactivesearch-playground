{
  "version": "1.3.0",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "scripts": {
    "start": "tsdx watch",
    "build": "tsdx build",
    "build:web": "yarn --cwd example build",
    "test": "tsdx test --passWithNoTests",
    "lint": "tsdx lint",
    "prepare": "tsdx build",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "storybook": "NODE_OPTIONS=--openssl-legacy-provider start-storybook -p 6006",
    "build-storybook": "NODE_OPTIONS=--openssl-legacy-provider build-storybook"
  },
  "peerDependencies": {
    "react": ">=16"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "name": "@appbaseio/reactivesearch-playground",
  "description": "A web playground which makes it easy for developers to work with Appbase.io REST API.",
  "repository": {
    "type": "git",
    "url": "https://github.com/appbaseio/reactivesearch-playground.git"
  },
  "homepage": "https://github.com/appbaseio/reactivesearch-playground#readme",
  "bugs": {
    "url": "https://github.com/appbaseio/reactivesearch-playground/issues"
  },
  "author": "Lakhan Samani - Muhammad Ashraf",
  "module": "dist/reactivesearch-playground.esm.js",
  "size-limit": [
    {
      "path": "dist/reactivesearch-playground.cjs.production.min.js",
      "limit": "10 MB"
    },
    {
      "path": "dist/reactivesearch-playground.esm.js",
      "limit": "10 MB"
    }
  ],
  "devDependencies": {
    "@babel/core": "^7.14.6",
    "@size-limit/preset-small-lib": "^4.12.0",
    "@storybook/addon-docs": "^6.2.9",
    "@storybook/addon-essentials": "^6.2.9",
    "@storybook/addon-info": "^5.3.21",
    "@storybook/addon-links": "^6.2.9",
    "@storybook/addons": "^6.2.9",
    "@storybook/react": "^6.2.9",
    "@types/react": "^17.0.14",
    "@types/react-dom": "^17.0.9",
    "@types/redux-logger": "^3.0.9",
    "babel-loader": "^8.2.2",
    "husky": "^6.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-is": "^17.0.2",
    "size-limit": "^4.12.0",
    "tsdx": "^0.14.1",
    "tslib": "^2.3.0",
    "typescript": "^4.3.4"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.3.1",
    "@reduxjs/toolkit": "^1.6.0",
    "@types/styled-components": "^5.1.11",
    "firebase": "^8.8.0",
    "react-redux": "^7.2.4",
    "redux-logger": "^3.0.6",
    "redux-persist": "^6.0.0",
    "styled-components": "^5.3.0",
    "xss": "^1.0.14"
  }
}
